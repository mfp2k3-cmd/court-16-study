+                s32 relative_target{};
+                std::memcpy(&relative_target, callsite_bytes.data() + 1, sizeof(relative_target));
+                call_target = caller_address + static_cast<s64>(relative_target);
+                if (call_target >= 0x400000 && call_target < 0x375c000) {
+                    ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(call_target),
