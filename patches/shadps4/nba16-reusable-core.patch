+            const auto fault_address = pExp->ExceptionRecord->ExceptionInformation[1];
+            constexpr char hex_digits[] = "0123456789abcdef";
+            std::array<u8, 48> code_bytes{};
+            SIZE_T code_bytes_read = 0;
+            const auto code_address = pExp->ContextRecord->Rip >= 16
+                                          ? pExp->ContextRecord->Rip - 16
+                                          : pExp->ContextRecord->Rip;
