+                instruction_bytes[instruction_length++] = hex_digits[byte >> 4];
+                instruction_bytes[instruction_length++] = hex_digits[byte & 0x0f];
+                if (i + 1 < code_bytes_read) instruction_bytes[instruction_length++] = ' ';
+            }
+            std::array<u64, 12> stack_words{};
+            SIZE_T stack_bytes_read = 0;
+            ReadProcessMemory(GetCurrentProcess(),
+                              reinterpret_cast<const void*>(pExp->ContextRecord->Rsp),
+                              stack_words.data(), sizeof(stack_words), &stack_bytes_read);
+            std::array<char, 12 * 19> stack_trace{};
+            std::size_t stack_length = 0;
+            const auto stack_word_count = stack_bytes_read / sizeof(u64);
+            for (std::size_t i = 0; i < stack_word_count; ++i) {
+                const auto written = std::snprintf(stack_trace.data() + stack_length,
+                                                   stack_trace.size() - stack_length,
+                                                   "%s%llx", i == 0 ? "" : " ",
+                                                   static_cast<unsigned long long>(stack_words[i]));
+                if (written <= 0) break;
+                stack_length += static_cast<std::size_t>(written);
+                if (stack_length >= stack_trace.size()) break;
+            }
+            std::array<char, 8 * 24> frame_trace{};
+            std::size_t frame_length = 0;
+            std::array<u64, 8> frame_returns{};
+            u64 frame_pointer = pExp->ContextRecord->Rbp;
+            for (std::size_t frame = 0; frame < 8 && frame_pointer != 0; ++frame) {
+                std::array<u64, 2> frame_record{};
+                SIZE_T frame_bytes_read = 0;
+                if (!ReadProcessMemory(GetCurrentProcess(),
+                                       reinterpret_cast<const void*>(frame_pointer),
+                                       frame_record.data(), sizeof(frame_record), &frame_bytes_read) ||
+                    frame_bytes_read != sizeof(frame_record)) {
+                    break;
+                }
+                const auto written = std::snprintf(frame_trace.data() + frame_length,
+                                                   frame_trace.size() - frame_length,
+                                                   "%s%llx:%llx", frame == 0 ? "" : " ",
+                                                   static_cast<unsigned long long>(frame_pointer),
+                                                   static_cast<unsigned long long>(frame_record[1]));
+                if (written <= 0) break;
+                frame_length += static_cast<std::size_t>(written);
+                frame_returns[frame] = frame_record[1];
+                if (frame_length >= frame_trace.size() || frame_record[0] <= frame_pointer)
+                    break;
+                frame_pointer = frame_record[0];
+            }
+            std::array<u8, 48> caller_bytes{};
+            SIZE_T caller_bytes_read = 0;
+            const u64 caller_address = frame_returns[0];
