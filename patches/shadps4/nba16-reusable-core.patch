+                const auto address = caller_address >= 16 ? caller_address - 16 : caller_address;
+                ReadProcessMemory(GetCurrentProcess(), reinterpret_cast<const void*>(address),
+                                  caller_bytes.data(), caller_bytes.size(), &caller_bytes_read);
+            }
+            std::array<char, 48 * 3> caller_instruction_bytes{};
+            std::size_t caller_instruction_length = 0;
+            for (std::size_t i = 0; i < caller_bytes_read; ++i) {
+                const auto byte = caller_bytes[i];
+                caller_instruction_bytes[caller_instruction_length++] = hex_digits[byte >> 4];
+                caller_instruction_bytes[caller_instruction_length++] = hex_digits[byte & 0x0f];
+                if (i + 1 < caller_bytes_read)
+                    caller_instruction_bytes[caller_instruction_length++] = ' ';
+            }
+            std::array<u8, 5> callsite_bytes{};
+            SIZE_T callsite_bytes_read = 0;
+            u64 call_target = 0;
+            std::array<u8, 0x540> function_bytes{};
+            SIZE_T function_bytes_read = 0;
+            if (caller_address >= 5 && ReadProcessMemory(
+                    GetCurrentProcess(), reinterpret_cast<const void*>(caller_address - 5),
+                    callsite_bytes.data(), callsite_bytes.size(), &callsite_bytes_read) &&
